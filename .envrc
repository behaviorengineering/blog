# direnv: https://direnv.net/
# After `cd` into this repo, run once: direnv allow
#
# These SUBSTACK_* exports override values in substack.json after JSON is loaded
# (see internal/substackbrowser/localconfig_env.go and docs/substack-html/README.md).
#
# Do not set SUBSTACK_MARKDOWN_LEAD_IMAGE_RESOLVE_ORIGIN to localhost here: Substack
# cannot fetch that URL for post cards or images. Uncomment only for a one-off local
# paste test while hugo server runs, then comment again.

source_up

# Polypus LLM gateway (homelab Tailscale). Chat/completions use this origin (no /v1).
export POLYPUS_BASE_URL="${POLYPUS_BASE_URL:-https://polypus-local.manticore-powan.ts.net}"
# Phoenix OTLP on the homelab (same host as POLYPUS_URL; gRPC :4317, UI :6006).
export POLYPUS_OTLP_ENDPOINT="${POLYPUS_OTLP_ENDPOINT:-polypus-local.manticore-powan.ts.net:4317}"
# Site eval / Gemma default: DeepInfra Gemma 4 26B on Polypus (not gemini_free, not unnamed cf_local).
# Do not inherit parent gemini_paid/gemma-* (thinking often returns empty content, finish_reason: length).
_site_gemma_default="deepinfra/google/gemma-4-26B-A4B-it"
case "${LOCAL_LLM_MODEL:-}" in
  gemini_paid/gemma-*|gemini_paid/Gemma-*)
    export LOCAL_LLM_MODEL="${_site_gemma_default}"
    ;;
  *)
    export LOCAL_LLM_MODEL="${LOCAL_LLM_MODEL:-${_site_gemma_default}}"
    ;;
esac
unset _site_gemma_default

export SUBSTACK_CHROMIUM_USER_DATA_DIRECTORY="${HOME}/.cache/substack-chrome-profile"
export SUBSTACK_PUBLISH_SCHEDULE_DEBUG_DOM_ON_FAILURE=1