flowchart TB
    classDef pastelLavender fill:#e8d4ef,stroke:#b894c9,color:#1c1422,stroke-width:2px
    classDef pastelSky fill:#cfe8f6,stroke:#7eb3d4,color:#1c1422,stroke-width:3px
    classDef pastelMint fill:#d4f0e2,stroke:#7fbf9a,color:#1c1422,stroke-width:4px,margin:2em
    classDef pastelNote fill:transparent,stroke:transparent,color:#ffffff,stroke-width:0px
    subgraph r1[" "]
        direction LR
        A("Empatía emocional"):::pastelLavender
        A1["Sientes lo que otros sienten;<br/>el cuerpo refleja la emoción"]:::pastelNote
        A ---> A1
    end
    subgraph r2[" "]
        direction LR
        B("Empatía cognitiva"):::pastelSky
        B1["Ves lo que otros ven;<br/>sigues su perspectiva"]:::pastelNote
        B ---> B1
    end
    subgraph r3[" "]
        direction LR
        C((Empatía moral-cognitiva ✅)):::pastelMint
        C1["Sabes culpa aunque ganes; juzgas desde ese estado de culpa."]:::pastelNote
        C ---> C1
    end
    r1 --> r2
    r2 --> r3
    linkStyle 0 stroke:#a8a4ad,stroke-width:2px,stroke-dasharray:2 3
    linkStyle 1 stroke:#a8a4ad,stroke-width:2px,stroke-dasharray:2 3
    linkStyle 2 stroke:#a8a4ad,stroke-width:2px,stroke-dasharray:2 3
    linkStyle 3 stroke:#a8a4ad,stroke-width:4px
    linkStyle 4 stroke:#a8a4ad,stroke-width:4px
